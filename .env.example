# Supabase — connection strings (obter em app.supabase.com > Project Settings > Database)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Supabase — chaves da app (obter em Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# APIs externas — só servidor, NUNCA prefixo NEXT_PUBLIC_
# FINNHUB_API_KEY serve as notícias por empresa E o Terminal de Notícias
# (scripts/ingest_news.ts) — ver docs/PIPELINES.md §1 e §6.
FINNHUB_API_KEY=
POLYGON_API_KEY=
GEMINI_API_KEY=
RESEND_API_KEY=

# Modelo Gemini Flash — confirmar nome disponível em aistudio.google.com/models
# Exemplo: gemini-2.0-flash, gemini-2.5-flash — não hardcoded no código
GEMINI_MODEL=

# Terminal de Notícias (docs/PIPELINES.md §6) — conta Gemini SEPARADA da acima.
# O ingestor corre em cron de hora a hora; com a conta partilhada esgotaria a
# quota gratuita que o analista e os briefs precisam para servir utilizadores.
# Se ficarem vazias, o pipeline cai para GEMINI_API_KEY/GEMINI_MODEL.
NEWS_GEMINI_API_KEY=
NEWS_GEMINI_MODEL=

# Discord — notificações e aprovação de artigos pelo telemóvel
# (docs/PIPELINES.md §6.6). Sem estas variáveis o pipeline funciona na mesma:
# os artigos ficam em DRAFT e aprovam-se em /{locale}/admin/news.
# Bot → Token. Precisa de escrever e pôr embeds no canal de revisão.
DISCORD_BOT_TOKEN=
# Id do canal privado onde caem os rascunhos (scripts/setup_discord_review_channel.ts)
DISCORD_REVIEW_CHANNEL_ID=
DISCORD_GUILD_ID=
# Ids NUMÉRICOS de Discord autorizados a aprovar, separados por vírgula.
# ⚠️ Não são usernames. VAZIO = ninguém aprova (falha fechado, de propósito).
DISCORD_ADMIN_USER_IDS=
# Segredo partilhado com o bot para POST /api/news/review. Gerar com:
#   openssl rand -hex 32
# ⚠️ VAZIO = o endpoint recusa tudo (503).
NEWS_REVIEW_SECRET=
# Só necessário se se migrar para uma app dedicada com Interactions Endpoint URL.
DISCORD_PUBLIC_KEY=

# i18n
NEXT_PUBLIC_DEFAULT_LOCALE=pt

# Encriptação de segredos de terceiros em repouso (ex: API keys de corretoras
# como a Trading212 — ver lib/crypto.ts). Mínimo 32 caracteres, gerar com:
# openssl rand -base64 32
ENCRYPTION_KEY=

# Crypto
ENCRYPTION_KEY=

# Rate limiting (Upstash Redis — obter em console.upstash.com > Create Database > REST API).
# OPCIONAL: sem estas vars o rate limiting cai para um fallback em memória (ok em
# dev, mas não partilhado entre instâncias serverless). Em produção na Vercel,
# configurar para rate limiting robusto por IP em /api/*. Ver lib/rateLimit.ts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Pulse — analytics first-party (ver docs/PULSE.md)
# PULSE_SALT: string aleatória para o hash anónimo de sessão (openssl rand -hex 16)
# ANALYTICS_ADMIN_EMAILS: emails com acesso a /analytics, separados por vírgula
PULSE_SALT=
ANALYTICS_ADMIN_EMAILS=

# Login de desenvolvimento (opcional, SÓ localhost): botão "Entrar como dev"
# na página de login quando NODE_ENV=development e estas vars existem.
# Usar password FORTE — a BD/auth é partilhada com produção.
DEV_LOGIN_EMAIL=
DEV_LOGIN_PASSWORD=
