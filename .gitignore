# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!scripts/.env.dev.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.py[cod]

# scratch / debug (ficheiros de exploração — nunca versionar)
scratch/

# relatórios gerados pelos scripts de validação (artefactos, não versionar)
fundamentals_verification_report.md
database_health_report.md

# claude code / codex / github copilot — skills e agents são tooling
# instalável (13M+ juntos), não código de produto. Mesmo raciocínio do
# /.claude/skills/ abaixo, para os outros sítios onde o instalador os pôs.
/.claude/skills/
/.agents/skills/
/.github/agents/
/.github/skills/
/skills-lock.json

# impeccable — relatórios de /impeccable critique (artefactos de sessão,
# nunca versionar). config.json e hook.cache.json ficam de fora desta regra
# de propósito: config.json guarda as exceções de regras revistas pela
# equipa (/impeccable hooks ignore-value), é o sítio reviewable a sério.
/.hero-concepts/
/.impeccable/critique/

# foundations lab: o HTML final é gerado pelo build (node design/foundations/build-foundations.js)
design/foundations/bullvision-foundations.html

# claude code — definições pessoais/locais, não partilhar com a equipa
/.claude/settings.local.json

# caches e outputs da reparação de fundamentais (nunca versionar)
scripts/.cache/
scripts/out/
# relatórios/dumps de auditoria gerados por scripts (ex: audit_null_fundamentals.txt)
scripts/audit_*.txt
scripts/*_audit*.txt

# Scratch e dumps locais — NUNCA versionar.
# Em 2026-08-09 um commit automático arrastou 268 ficheiros (~29 MB) para cá,
# incluindo .scratch/bullquant_public_backup.dump: um dump de produção com as
# tabelas users, portfolios e broker_connections. Não chegou a ser enviado.
.scratch/
scratch/
scripts/backups/
*.dump
