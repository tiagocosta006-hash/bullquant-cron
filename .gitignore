# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!scripts/.env.dev.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.py[cod]

# scratch / debug (ficheiros de exploração — nunca versionar)
scratch/

# relatórios gerados pelos scripts de validação (artefactos, não versionar)
fundamentals_verification_report.md
database_health_report.md

# claude code — skills são tooling instalável (8M+), não código de produto
/.claude/skills/

# foundations lab: o HTML final é gerado pelo build (node design/foundations/build-foundations.js)
design/foundations/bullvision-foundations.html

# claude code — definições pessoais/locais, não partilhar com a equipa
/.claude/settings.local.json

# caches e outputs da reparação de fundamentais (nunca versionar)
scripts/.cache/
scripts/out/
