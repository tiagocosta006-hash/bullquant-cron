generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  name              String?
  avatarUrl         String?
  plan              Plan               @default(FREE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  aiUsageLogs       AIUsageLog[]
  brokerConnections BrokerConnection[]
  dcfAnalyses       DcfAnalysis[]
  portfolio         Portfolio?
  watchlistItems    WatchlistItem[]

  // Paddle Billing Fields
  paddleCustomerId     String?   @unique
  paddleSubscriptionId String?   @unique
  paddleStatus         String?
  paddlePriceId        String?

  @@map("users")
}

model Company {
  id                     String               @id @default(cuid())
  ticker                 String               @unique
  name                   String
  cik                    String?              @unique
  exchange               String
  sector                 String?
  industry               String?
  country                String               @default("US")
  currency               String               @default("USD")
  logoUrl                String?
  description            String?
  website                String?
  employees              Int?
  isActive               Boolean              @default(true)
  lastFundamentalsUpdate DateTime?
  lastPriceUpdate        DateTime?
  descriptionGeneratedAt DateTime?
  geographicFocus        String?
  bullCase               String?   @db.Text
  bearCase               String?   @db.Text
  swot                   Json?
  extraInfo              String?   @db.Text
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  ceo                    String?
  aiInsightCache         AIInsightCache?
  analystReport          AnalystReport?
  filings                FilingCache[]
  companyBrief           CompanyBrief?
  corporateEvents        CorporateEvent[]
  dcfAnalyses            DcfAnalysis[]
  earnings               EarningsEvent[]
  fundamentals           Fundamental[]
  insiderTxns            InsiderTransaction[]
  managementProfile      ManagementProfile?
  portfolioItems         PortfolioItem[]
  prices                 Price[]
  watchlistItems         WatchlistItem[]

  @@index([ticker])
  @@index([exchange])
  @@index([sector])
  @@map("companies")
}

model Fundamental {
  id                     String     @id @default(cuid())
  companyId              String
  periodType             PeriodType
  fiscalYear             Int
  fiscalQuarter          Int?
  periodEnd              DateTime
  filedAt                DateTime?
  revenue                Decimal?   @db.Decimal(20, 4)
  costOfRevenue          Decimal?   @db.Decimal(20, 4)
  grossProfit            Decimal?   @db.Decimal(20, 4)
  operatingExpenses      Decimal?   @db.Decimal(20, 4)
  researchAndDevelopment Decimal?   @db.Decimal(20, 4)
  sellingGeneralAndAdmin Decimal?   @db.Decimal(20, 4)
  ebitda                 Decimal?   @db.Decimal(20, 4)
  operatingIncome        Decimal?   @db.Decimal(20, 4)
  revenueSegments        Json?
  interestExpense        Decimal?   @db.Decimal(20, 4)
  taxExpense             Decimal?   @db.Decimal(20, 4)
  netIncome              Decimal?   @db.Decimal(20, 4)
  epsDiluted             Decimal?   @db.Decimal(10, 4)
  sharesOutstanding      Decimal?   @db.Decimal(20, 4)
  operatingCashFlow      Decimal?   @db.Decimal(20, 4)
  capex                  Decimal?   @db.Decimal(20, 4)
  freeCashFlow           Decimal?   @db.Decimal(20, 4)
  totalAssets            Decimal?   @db.Decimal(20, 4)
  totalCurrentLiab       Decimal?   @db.Decimal(20, 4)
  longTermDebt           Decimal?   @db.Decimal(20, 4)
  totalDebt              Decimal?   @db.Decimal(20, 4)
  cash                   Decimal?   @db.Decimal(20, 4)
  totalEquity            Decimal?   @db.Decimal(20, 4)
  grossMargin            Decimal?   @db.Decimal(8, 6)
  operatingMargin        Decimal?   @db.Decimal(8, 6)
  netMargin              Decimal?   @db.Decimal(8, 6)
  roic                   Decimal?   @db.Decimal(8, 6)
  returnOnEquity         Decimal?   @db.Decimal(8, 6)
  dividendPerShare       Decimal?   @db.Decimal(10, 4)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  businessKpis           Json?
  company                Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, periodType, fiscalYear, fiscalQuarter])
  @@index([companyId, periodEnd])
  @@index([companyId, periodType, fiscalYear])
  @@map("fundamentals")
}

model Price {
  ticker  String
  date    DateTime @db.Date
  open    Decimal? @db.Decimal(12, 4)
  high    Decimal? @db.Decimal(12, 4)
  low     Decimal? @db.Decimal(12, 4)
  close   Decimal  @db.Decimal(12, 4)
  volume  BigInt?
  company Company  @relation(fields: [ticker], references: [ticker])

  @@id([ticker, date])
  @@map("prices")
}

model Portfolio {
  id        String          @id @default(cuid())
  userId    String          @unique
  name      String          @default("O Meu Portfólio")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  items     PortfolioItem[]
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("portfolios")
}

model PortfolioItem {
  id          String    @id @default(cuid())
  portfolioId String
  companyId   String
  addedAt     DateTime  @default(now())
  quantity    Decimal?  @db.Decimal(20, 6)
  avgBuyPrice Decimal?  @db.Decimal(12, 4)
  // Detalhes opcionais da posição (entrada manual; o sync Trading212 não os
  // escreve — têm de continuar nullable para o upsert do sync não partir)
  buyDate     DateTime?
  broker      String?
  currency    String?
  fees        Decimal?  @db.Decimal(12, 4)
  notes       String?   @db.Text
  company     Company   @relation(fields: [companyId], references: [id])
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, companyId])
  @@index([portfolioId])
  @@map("portfolio_items")
}

// Watchlist (lista de observação) — separada do portfólio: seguir uma empresa
// não implica ter posição, e uma empresa pode estar em ambas as listas.
model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  addedAt   DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId])
  @@map("watchlist_items")
}

model BrokerConnection {
  id                 String    @id @default(cuid())
  userId             String
  broker             Broker
  encryptedApiKey    String    @db.Text
  encryptedApiSecret String    @db.Text
  lastSyncedAt       DateTime?
  lastSyncError      String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, broker])
  @@index([userId])
  @@map("broker_connections")
}

model DcfAnalysis {
  id             String   @id @default(cuid())
  userId         String
  companyId      String
  label          String?
  notes          String?  @db.Text
  fcfMode        String?
  fcf0           Decimal  @db.Decimal(20, 4)
  growthStage1   Decimal  @db.Decimal(8, 6)
  growthStage2   Decimal  @db.Decimal(8, 6)
  wacc           Decimal  @db.Decimal(8, 6)
  terminalGrowth Decimal  @db.Decimal(8, 6)
  shares         Decimal  @db.Decimal(20, 4)
  netDebt        Decimal  @db.Decimal(20, 4)
  fairValue      Decimal  @db.Decimal(20, 4)
  priceAtSave    Decimal? @db.Decimal(20, 4)
  marginOfSafety Decimal? @db.Decimal(8, 6)
  createdAt      DateTime @default(now())
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, companyId, createdAt])
  @@map("dcf_analyses")
}

model EarningsEvent {
  id              String       @id @default(cuid())
  companyId       String
  date            DateTime     @db.Date
  hour            EarningsHour @default(UNKNOWN)
  fiscalYear      Int
  fiscalQuarter   Int
  epsEstimate     Decimal?     @db.Decimal(10, 4)
  epsActual       Decimal?     @db.Decimal(10, 4)
  revenueEstimate Decimal?     @db.Decimal(20, 4)
  revenueActual   Decimal?     @db.Decimal(20, 4)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, fiscalYear, fiscalQuarter])
  @@index([date])
  @@index([companyId, date])
  @@map("earnings_events")
}

// Eventos macro/market-wide, sem empresa associada: FOMC, CPI, emprego, GDP.
// Movem o discount rate/WACC — relevantes para valuation e DCF.
model MarketEvent {
  id         String          @id @default(cuid())
  type       MarketEventType
  date       DateTime        @db.Date
  time       String? // ex: "14:00 ET"; null = evento all-day
  title      String
  importance EventImportance @default(MEDIUM)
  country    String          @default("US")
  actual     String?
  estimate   String?
  previous   String?
  source     String          @default("curated")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([type, date])
  @@index([date])
  @@map("market_events")
}

// Eventos por empresa que não são earnings: dividendos (ex-date/pay-date),
// splits, AGM, investor days, IPOs.
model CorporateEvent {
  id         String             @id @default(cuid())
  companyId  String
  type       CorporateEventType
  date       DateTime           @db.Date // ex-date para dividendos
  payDate    DateTime?          @db.Date
  amount     Decimal?           @db.Decimal(12, 4) // dividendo por ação
  splitRatio String?
  note       String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  company    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, type, date])
  @@index([date])
  @@index([companyId, date])
  @@map("corporate_events")
}

model AIInsightCache {
  id               String   @id @default(cuid())
  companyId        String   @unique
  executiveSummary String
  moat             String
  catalysts        String
  risks            String
  modelVersion     String
  generatedAt      DateTime @default(now())
  expiresAt        DateTime
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, expiresAt])
  @@map("ai_insight_cache")
}

model CompanyBrief {
  id           String   @id @default(cuid())
  companyId    String   @unique
  briefData    Json
  modelVersion String
  generatedAt  DateTime @default(now())
  expiresAt    DateTime
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, expiresAt])
  @@map("company_brief")
}

model ManagementProfile {
  id                          String   @id @default(cuid())
  companyId                   String   @unique
  ceoName                     String
  isFamilyRun                 Boolean
  capitalAllocationRating     String
  skinInTheGame               String
  modelVersion                String
  generatedAt                 DateTime @default(now())
  expiresAt                   DateTime
  analysis_en                 String
  analysis_pt                 String
  capitalAllocationSummary_en String
  capitalAllocationSummary_pt String
  familyInfluence_en          String?
  familyInfluence_pt          String?
  tenure_en                   String
  tenure_pt                   String
  company                     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, expiresAt])
  @@map("management_profile")
}

// Relatório do Analista IA — dossier grounded (BD + 10-K) gerado por empresa.
// Espelha o padrão de cache do AIInsightCache (TTL via expiresAt).
model AnalystReport {
  id           String   @id @default(cuid())
  companyId    String   @unique
  reportData   Json // secções + citações (executiveSummary, moat, riscos, KPIs, bull/bear…)
  secUrl       String? // URL do 10-K/20-F usado como fonte
  filingLabel  String? // ex: "10-K FY2024"
  modelVersion String
  generatedAt  DateTime @default(now())
  expiresAt    DateTime
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, expiresAt])
  @@map("analyst_reports")
}

// Cache do texto do filing SEC (10-K/20-F) — evita re-download de ~800KB por
// pergunta do chat. Uma linha por (empresa, accession).
model FilingCache {
  id        String   @id @default(cuid())
  companyId String
  accession String
  form      String // "10-K", "20-F", "40-F"
  url       String
  text      String   @db.Text
  fetchedAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, accession])
  @@index([companyId, fetchedAt])
  @@map("filing_cache")
}

model AIUsageLog {
  id      String   @id @default(cuid())
  userId  String
  ticker  String
  action  String   @default("legacy") // "brief" | "management" | "analyst_report" | "analyst_chat" | "peer_report" | "kpi_extraction"
  credits Int      @default(1) // peso real da ação, não uma contagem de linhas — ver lib/ai/credits.ts
  usedAt  DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("ai_usage_logs")
}

model InsiderTransaction {
  id               String         @id @default(cuid())
  companyId        String
  insiderName      String
  title            String?
  type             InsiderTxnType
  transactionCode  String?
  shares           Decimal        @db.Decimal(20, 4)
  sharesChange     Decimal?       @db.Decimal(20, 4)
  price            Decimal?       @db.Decimal(12, 4)
  value            Decimal?       @db.Decimal(20, 4)
  sharesOwnedAfter Decimal?       @db.Decimal(20, 4)
  transactionDate  DateTime       @db.Date
  filedAt          DateTime?      @db.Date
  source           String         @default("finnhub")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, insiderName, transactionDate, transactionCode, sharesChange])
  @@index([companyId, transactionDate])
  @@map("insider_transactions")
}

enum Plan {
  FREE
  PRO

  @@map("plan")
}

enum PeriodType {
  QUARTERLY
  ANNUAL

  @@map("period_type")
}

enum Broker {
  TRADING212

  @@map("broker")
}

enum EarningsHour {
  BMO
  AMC
  DMH
  UNKNOWN

  @@map("earnings_hour")
}

enum MarketEventType {
  FOMC
  CPI
  JOBS
  GDP
  PCE
  RETAIL_SALES
  OTHER

  @@map("market_event_type")
}

enum CorporateEventType {
  DIVIDEND
  SPLIT
  AGM
  INVESTOR_DAY
  IPO

  @@map("corporate_event_type")
}

enum EventImportance {
  LOW
  MEDIUM
  HIGH

  @@map("event_importance")
}

enum InsiderTxnType {
  BUY
  SELL
  OTHER

  @@map("insider_txn_type")
}
