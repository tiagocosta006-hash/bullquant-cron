generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  name              String?
  avatarUrl         String?
  plan              Plan               @default(FREE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  aiUsageLogs       AIUsageLog[]
  brokerConnections BrokerConnection[]
  brokerCashFlows   BrokerCashFlow[]
  dcfAnalyses       DcfAnalysis[]
  portfolio         Portfolio?
  watchlistItems    WatchlistItem[]
  watchlists        Watchlist[]

  // Paddle Billing Fields
  paddleCustomerId     String? @unique
  paddleSubscriptionId String? @unique
  paddleStatus         String?
  paddlePriceId        String?

  @@map("users")
}

model Company {
  id                     String               @id @default(cuid())
  ticker                 String               @unique
  name                   String
  cik                    String?              @unique
  exchange               String
  sector                 String?
  industry               String?
  country                String               @default("US")
  currency               String               @default("USD")
  logoUrl                String?
  description            String?
  website                String?
  employees              Int?
  isActive               Boolean              @default(true)
  lastFundamentalsUpdate DateTime?
  lastPriceUpdate        DateTime?
  descriptionGeneratedAt DateTime?
  geographicFocus        String?
  bullCase               String?              @db.Text
  bearCase               String?              @db.Text
  swot                   Json?
  extraInfo              String?              @db.Text
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  ceo                    String?
  aiInsightCache         AIInsightCache?
  analystReport          AnalystReport?
  filings                FilingCache[]
  companyBrief           CompanyBrief?
  corporateEvents        CorporateEvent[]
  dcfAnalyses            DcfAnalysis[]
  earnings               EarningsEvent[]
  fundamentals           Fundamental[]
  insiderTxns            InsiderTransaction[]
  managementProfile      ManagementProfile?
  portfolioItems         PortfolioItem[]
  prices                 Price[]
  watchlistItems         WatchlistItem[]
  watchlistEntries       WatchlistEntry[]

  @@index([ticker])
  @@index([exchange])
  @@index([sector])
  @@map("companies")
}

model Fundamental {
  id                     String     @id @default(cuid())
  companyId              String
  periodType             PeriodType
  fiscalYear             Int
  fiscalQuarter          Int?
  periodEnd              DateTime
  filedAt                DateTime?
  revenue                Decimal?   @db.Decimal(20, 4)
  costOfRevenue          Decimal?   @db.Decimal(20, 4)
  grossProfit            Decimal?   @db.Decimal(20, 4)
  operatingExpenses      Decimal?   @db.Decimal(20, 4)
  researchAndDevelopment Decimal?   @db.Decimal(20, 4)
  sellingGeneralAndAdmin Decimal?   @db.Decimal(20, 4)
  ebitda                 Decimal?   @db.Decimal(20, 4)
  operatingIncome        Decimal?   @db.Decimal(20, 4)
  revenueSegments        Json?
  // Todas as partições de receita que reconciliam com o total, uma por eixo XBRL:
  // {"segment": {...}, "product": {...}, "geography": {...}}. revenueSegments
  // acima continua a ser a partição principal em mapa plano (shape antiga).
  revenueSegmentsByAxis  Json?
  interestExpense        Decimal?   @db.Decimal(20, 4)
  taxExpense             Decimal?   @db.Decimal(20, 4)
  netIncome              Decimal?   @db.Decimal(20, 4)
  epsDiluted             Decimal?   @db.Decimal(10, 4)
  sharesOutstanding      Decimal?   @db.Decimal(20, 4)
  operatingCashFlow      Decimal?   @db.Decimal(20, 4)
  capex                  Decimal?   @db.Decimal(20, 4)
  freeCashFlow           Decimal?   @db.Decimal(20, 4)
  totalAssets            Decimal?   @db.Decimal(20, 4)
  totalCurrentLiab       Decimal?   @db.Decimal(20, 4)
  longTermDebt           Decimal?   @db.Decimal(20, 4)
  totalDebt              Decimal?   @db.Decimal(20, 4)
  cash                   Decimal?   @db.Decimal(20, 4)
  totalEquity            Decimal?   @db.Decimal(20, 4)
  // Interesses não-controlados. Sem este campo o balanço não fecha em 534 linhas
  // (10,5%): `totalEquity` é a parte do GRUPO e Ativo = Passivo + Capital Próprio
  // só se verifica somando os NCI. No KKR são 48,0 mM que faltavam a 30,9 mM
  // para dar os 78,9 mM que o próprio filing declara. Mantém-se separado, em vez
  // de inflar totalEquity, para o ROE continuar a usar o capital do grupo.
  minorityInterest       Decimal?   @db.Decimal(20, 4)
  grossMargin            Decimal?   @db.Decimal(8, 6)
  operatingMargin        Decimal?   @db.Decimal(8, 6)
  netMargin              Decimal?   @db.Decimal(8, 6)
  roic                   Decimal?   @db.Decimal(8, 6)
  returnOnEquity         Decimal?   @db.Decimal(8, 6)
  dividendPerShare       Decimal?   @db.Decimal(10, 4)

  // --- Demonstração de Resultados (DRE) Detalhada ---
  depreciationAndAmortization Decimal? @db.Decimal(20, 4)
  incomeBeforeTax             Decimal? @db.Decimal(20, 4)
  netInterestIncome           Decimal? @db.Decimal(20, 4)
  otherNonOperatingIncome     Decimal? @db.Decimal(20, 4)

  // --- Balanço Patrimonial Detalhado ---
  totalCurrentAssets     Decimal? @db.Decimal(20, 4)
  accountsReceivable     Decimal? @db.Decimal(20, 4)
  inventory              Decimal? @db.Decimal(20, 4)
  propertyPlantEquipment Decimal? @db.Decimal(20, 4)
  goodwillAndIntangibles Decimal? @db.Decimal(20, 4)
  accountsPayable        Decimal? @db.Decimal(20, 4)
  shortTermDebt          Decimal? @db.Decimal(20, 4)
  totalLiabilities       Decimal? @db.Decimal(20, 4)
  retainedEarnings       Decimal? @db.Decimal(20, 4)

  // --- Fluxos de Caixa Detalhados ---
  investingCashFlow      Decimal? @db.Decimal(20, 4)
  financingCashFlow      Decimal? @db.Decimal(20, 4)
  stockBasedCompensation Decimal? @db.Decimal(20, 4)
  shareRepurchases       Decimal? @db.Decimal(20, 4)
  dividendsPaid          Decimal? @db.Decimal(20, 4)
  netChangeInCash        Decimal? @db.Decimal(20, 4)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  businessKpis Json?
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, periodType, fiscalYear, fiscalQuarter])
  @@index([companyId, periodEnd])
  @@index([companyId, periodType, fiscalYear])
  @@map("fundamentals")
}

model Price {
  ticker  String
  date    DateTime @db.Date
  open    Decimal? @db.Decimal(12, 4)
  high    Decimal? @db.Decimal(12, 4)
  low     Decimal? @db.Decimal(12, 4)
  close   Decimal  @db.Decimal(12, 4)
  volume  BigInt?
  company Company  @relation(fields: [ticker], references: [ticker])

  @@id([ticker, date])
  @@map("prices")
}

model Portfolio {
  id        String          @id @default(cuid())
  userId    String          @unique
  name      String          @default("O Meu Portfólio")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  items     PortfolioItem[]
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("portfolios")
}

model PortfolioItem {
  id          String    @id @default(cuid())
  portfolioId String
  companyId   String
  addedAt     DateTime  @default(now())
  quantity    Decimal?  @db.Decimal(20, 6)
  avgBuyPrice Decimal?  @db.Decimal(12, 4)
  // Detalhes opcionais da posição (entrada manual; o sync Trading212 não os
  // escreve — têm de continuar nullable para o upsert do sync não partir)
  buyDate     DateTime?
  broker      String?
  currency    String?
  fees        Decimal?  @db.Decimal(12, 4)
  notes       String?   @db.Text
  company     Company   @relation(fields: [companyId], references: [id])
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, companyId])
  @@index([portfolioId])
  @@map("portfolio_items")
}

// Watchlist (lista de observação) — separada do portfólio: seguir uma empresa
// não implica ter posição, e uma empresa pode estar em ambas as listas.
model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  addedAt   DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId])
  @@map("watchlist_items")
}

// Multi-watchlists (hub "Outros" do explore) — listas nomeadas pelo user,
// à parte do WatchlistItem flat ("Seguir" continua a escrever ali). Exceção
// sinalizada e aprovada ao "1 portfólio por user" do CLAUDE.md: aqui é
// deliberadamente N listas por user.
model Watchlist {
  id        String           @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries   WatchlistEntry[]

  @@index([userId])
  @@map("watchlists")
}

model WatchlistEntry {
  id          String    @id @default(cuid())
  watchlistId String
  companyId   String
  addedAt     DateTime  @default(now())
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, companyId])
  @@map("watchlist_entries")
}

model BrokerConnection {
  id                 String    @id @default(cuid())
  userId             String
  broker             Broker
  encryptedApiKey    String    @db.Text
  encryptedApiSecret String    @db.Text
  lastSyncedAt       DateTime?
  lastSyncError      String?   @db.Text

  // ── Estado da sincronização do histórico de caixa (para o XIRR) ──
  // O endpoint de transações tem rate limit de 6 req/min e só devolve 50
  // movimentos por página, logo uma conta com muito histórico não cabe numa
  // única chamada. Guardamos o cursor da próxima página para retomar o
  // backfill em chamadas seguintes; quando termina, `cashFlowBackfillDone`
  // fica true e as sincronizações passam a ser incrementais.
  cashFlowCursor       String?   @db.Text
  cashFlowBackfillDone Boolean   @default(false)
  cashFlowsSyncedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, broker])
  @@index([userId])
  @@map("broker_connections")
}

// ── MOVIMENTOS DE CAIXA DA CORRETORA ──────────────
// Depósitos, levantamentos, taxas e juros importados da corretora. Servem para
// calcular o XIRR (retorno anualizado) em lib/finance/xirr.ts — sem as datas de
// cada entrada de dinheiro, só é possível calcular retorno total, não anualizado.
//
// `reference` é o ID do movimento na corretora — é a chave de deduplicação que
// torna a sincronização idempotente (re-ler páginas sobrepostas não duplica).
model BrokerCashFlow {
  id     String @id @default(cuid())
  userId String
  broker Broker

  reference  String
  type       String // DEPOSIT | WITHDRAW | TRANSFER | FEE | INTEREST_ON_FREE_CASH | LENDING_INTEREST
  amount     Decimal  @db.Decimal(20, 6)
  currency   String
  occurredAt DateTime

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, broker, reference])
  @@index([userId, broker, occurredAt])
  @@map("broker_cash_flows")
}

model DcfAnalysis {
  id             String   @id @default(cuid())
  userId         String
  companyId      String
  label          String?
  notes          String?  @db.Text
  fcfMode        String?
  fcf0           Decimal  @db.Decimal(20, 4)
  growthStage1   Decimal  @db.Decimal(8, 6)
  growthStage2   Decimal  @db.Decimal(8, 6)
  wacc           Decimal  @db.Decimal(8, 6)
  terminalGrowth Decimal  @db.Decimal(8, 6)
  shares         Decimal  @db.Decimal(20, 4)
  netDebt        Decimal  @db.Decimal(20, 4)
  fairValue      Decimal  @db.Decimal(20, 4)
  priceAtSave    Decimal? @db.Decimal(20, 4)
  marginOfSafety Decimal? @db.Decimal(8, 6)
  isPublic       Boolean  @default(false)
  createdAt      DateTime @default(now())
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, companyId, createdAt])
  @@map("dcf_analyses")
}

model EarningsEvent {
  id              String       @id @default(cuid())
  companyId       String
  date            DateTime     @db.Date
  hour            EarningsHour @default(UNKNOWN)
  fiscalYear      Int
  fiscalQuarter   Int
  epsEstimate     Decimal?     @db.Decimal(10, 4)
  epsActual       Decimal?     @db.Decimal(10, 4)
  revenueEstimate Decimal?     @db.Decimal(20, 4)
  revenueActual   Decimal?     @db.Decimal(20, 4)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, fiscalYear, fiscalQuarter])
  @@index([date])
  @@index([companyId, date])
  @@map("earnings_events")
}

// Eventos macro/market-wide, sem empresa associada: FOMC, CPI, emprego, GDP.
// Movem o discount rate/WACC — relevantes para valuation e DCF.
model MarketEvent {
  id         String          @id @default(cuid())
  type       MarketEventType
  date       DateTime        @db.Date
  time       String? // ex: "14:00 ET"; null = evento all-day
  title      String
  importance EventImportance @default(MEDIUM)
  country    String          @default("US")
  actual     String?
  estimate   String?
  previous   String?
  source     String          @default("curated")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([type, date])
  @@index([date])
  @@map("market_events")
}

// Eventos por empresa que não são earnings: dividendos (ex-date/pay-date),
// splits, AGM, investor days, IPOs.
model CorporateEvent {
  id         String             @id @default(cuid())
  companyId  String
  type       CorporateEventType
  date       DateTime           @db.Date // ex-date para dividendos
  payDate    DateTime?          @db.Date
  amount     Decimal?           @db.Decimal(12, 4) // dividendo por ação
  splitRatio String?
  note       String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  company    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, type, date])
  @@index([date])
  @@index([companyId, date])
  @@map("corporate_events")
}

model AIInsightCache {
  id               String   @id @default(cuid())
  companyId        String   @unique
  executiveSummary String
  moat             String
  catalysts        String
  risks            String
  modelVersion     String
  generatedAt      DateTime @default(now())
  expiresAt        DateTime
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, expiresAt])
  @@map("ai_insight_cache")
}

model CompanyBrief {
  id           String   @id @default(cuid())
  companyId    String   @unique
  briefData    Json
  modelVersion String
  generatedAt  DateTime @default(now())
  expiresAt    DateTime
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, expiresAt])
  @@map("company_brief")
}

model ManagementProfile {
  id                          String   @id @default(cuid())
  companyId                   String   @unique
  ceoName                     String
  isFamilyRun                 Boolean
  capitalAllocationRating     String
  skinInTheGame               String
  modelVersion                String
  generatedAt                 DateTime @default(now())
  expiresAt                   DateTime
  analysis_en                 String
  analysis_pt                 String
  capitalAllocationSummary_en String
  capitalAllocationSummary_pt String
  familyInfluence_en          String?
  familyInfluence_pt          String?
  tenure_en                   String
  tenure_pt                   String
  company                     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, expiresAt])
  @@map("management_profile")
}

// Relatório do Analista IA — dossier grounded (BD + 10-K) gerado por empresa.
// Espelha o padrão de cache do AIInsightCache (TTL via expiresAt).
model AnalystReport {
  id           String   @id @default(cuid())
  companyId    String   @unique
  reportData   Json // secções + citações (executiveSummary, moat, riscos, KPIs, bull/bear…)
  secUrl       String? // URL do 10-K/20-F usado como fonte
  filingLabel  String? // ex: "10-K FY2024"
  modelVersion String
  generatedAt  DateTime @default(now())
  expiresAt    DateTime
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, expiresAt])
  @@map("analyst_reports")
}

// Cache do texto do filing SEC (10-K/20-F) — evita re-download de ~800KB por
// pergunta do chat. Uma linha por (empresa, accession).
model FilingCache {
  id        String   @id @default(cuid())
  companyId String
  accession String
  form      String // "10-K", "20-F", "40-F"
  url       String
  text      String   @db.Text
  fetchedAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, accession])
  @@index([companyId, fetchedAt])
  @@map("filing_cache")
}

model AIUsageLog {
  id      String   @id @default(cuid())
  userId  String
  ticker  String
  action  String   @default("legacy") // "brief" | "management" | "analyst_report" | "analyst_chat" | "peer_report" | "kpi_extraction"
  credits Int      @default(1) // peso real da ação, não uma contagem de linhas — ver lib/ai/credits.ts
  usedAt  DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("ai_usage_logs")
}

model InsiderTransaction {
  id               String         @id @default(cuid())
  companyId        String
  insiderName      String
  title            String?
  type             InsiderTxnType
  transactionCode  String?
  shares           Decimal        @db.Decimal(20, 4)
  sharesChange     Decimal?       @db.Decimal(20, 4)
  price            Decimal?       @db.Decimal(12, 4)
  value            Decimal?       @db.Decimal(20, 4)
  sharesOwnedAfter Decimal?       @db.Decimal(20, 4)
  transactionDate  DateTime       @db.Date
  filedAt          DateTime?      @db.Date
  source           String         @default("finnhub")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, insiderName, transactionDate, transactionCode, sharesChange])
  @@index([companyId, transactionDate])
  @@map("insider_transactions")
}

// ── PULSE (analytics first-party) ─────────────
// Sem cookies e sem PII: sessionId é um hash SHA-256 com salt que roda
// diariamente (dia|salt|ip|ua) — o IP nunca é guardado. Ver docs/PULSE.md.
model PulseEvent {
  id        String   @id @default(cuid())
  type      String // pageview | cta_click | signup | dcf_saved | watchlist_add
  path      String
  referrer  String? // só referrers externos
  country   String? // header x-vercel-ip-country — nunca o IP
  device    String   @default("desktop") // desktop | mobile | tablet
  locale    String?
  sessionId String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([sessionId, createdAt])
  @@index([path, createdAt])
  @@map("pulse_events")
}

enum Plan {
  FREE
  PRO

  @@map("plan")
}

enum PeriodType {
  QUARTERLY
  ANNUAL

  @@map("period_type")
}

enum Broker {
  TRADING212

  @@map("broker")
}

enum EarningsHour {
  BMO
  AMC
  DMH
  UNKNOWN

  @@map("earnings_hour")
}

enum MarketEventType {
  FOMC
  CPI
  JOBS
  GDP
  PCE
  RETAIL_SALES
  OTHER

  @@map("market_event_type")
}

enum CorporateEventType {
  DIVIDEND
  SPLIT
  AGM
  INVESTOR_DAY
  IPO

  @@map("corporate_event_type")
}

enum EventImportance {
  LOW
  MEDIUM
  HIGH

  @@map("event_importance")
}

enum InsiderTxnType {
  BUY
  SELL
  OTHER

  @@map("insider_txn_type")
}

model MacroCommentary {
  id        String   @id @default(cuid())
  type      String   @unique
  content   String   @db.Text
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("macro_commentary")
}

// ---------------------------------------------------------------------------
// Terminal de Notícias — pipeline RSS/Finnhub → clustering → triagem IA →
// mini-artigo em PT-PT assinado pela Bull Value.
// ---------------------------------------------------------------------------

enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("news_status")
}

enum NewsCategory {
  MACRO
  EARNINGS
  MA
  CRYPTO
  COMMODITIES
  POLICY
  COMPANY

  @@map("news_category")
}

/// Item bruto tal como veio do feed. Nunca exposto ao público — serve de
/// matéria-prima para o clustering e de trilho de auditoria das fontes.
model NewsRawItem {
  id          String       @id @default(cuid())
  /// sha1(título normalizado) — impede reprocessar o mesmo artigo a cada hora
  dedupKey    String       @unique
  source      String
  sourceUrl   String
  title       String
  summary     String?      @db.Text
  imageUrl    String?
  publishedAt DateTime
  fetchedAt   DateTime     @default(now())
  clusterId   String?
  cluster     NewsCluster? @relation(fields: [clusterId], references: [id], onDelete: SetNull)

  @@index([publishedAt])
  @@index([clusterId])
  @@map("news_raw_item")
}

/// Uma história — agrupa os itens que várias fontes publicaram sobre o mesmo
/// acontecimento. Cobertura por várias fontes é o sinal de que "está a bombar".
model NewsCluster {
  id             String        @id @default(cuid())
  /// 0-100 atribuído pela triagem IA; null = ainda não triado
  relevanceScore Int?
  category       NewsCategory?
  tickers        String[]      @default([])
  triageReason   String?       @db.Text
  triagedAt      DateTime?
  createdAt      DateTime      @default(now())
  items          NewsRawItem[]
  article        NewsArticle?

  @@index([relevanceScore])
  @@index([createdAt])
  @@map("news_cluster")
}

/// O mini-artigo em Português de Portugal gerado pela IA da Bull Value.
model NewsArticle {
  id           String       @id @default(cuid())
  slug         String       @unique
  clusterId    String       @unique
  titulo       String
  resumoCurto  String
  corpo        String       @db.Text
  impacto      String       @db.Text
  categoria    NewsCategory
  tickers      String[]     @default([])
  sentimento   String
  status       NewsStatus   @default(PUBLISHED)
  /// [{ name, url }] — atribuição obrigatória às fontes originais
  sources      Json
  imageUrl     String?
  modelVersion String
  publishedAt  DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  cluster      NewsCluster  @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  @@index([status, publishedAt])
  @@index([tickers])
  @@map("news_article")
}
